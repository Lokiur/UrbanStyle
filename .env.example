# Copia este archivo como .env y rellena los valores.
# .env esta en .gitignore: nunca subas las claves reales.

# Clave para firmar sesiones y enlaces de recuperacion.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Correo SMTP para enviar los enlaces de recuperacion.
# Si MAIL_SERVER queda vacio, el correo se imprime en la consola (desarrollo).
# Gmail: activa la verificacion en 2 pasos y crea una "contraseña de aplicacion".
MAIL_SERVER=
# Gmail: MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=UrbanStyle <tucorreo@gmail.com>
