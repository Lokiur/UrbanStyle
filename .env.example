# Copia este archivo como .env y rellena los valores.
# .env esta en .gitignore: nunca subas las claves reales.

# Clave para firmar sesiones y enlaces de recuperacion.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Base de datos MySQL. Si se dejan vacias, se usa un XAMPP local
# (127.0.0.1, root, sin password, BD "urbanstyle") para no romper el
# desarrollo local. En produccion (Render, etc.) hay que definirlas con
# los datos del MySQL externo (Render no incluye MySQL gratis).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=urbanstyle
# DB_SSL=true si el proveedor exige TLS (Aiven, TiDB Cloud, etc.)
DB_SSL=
# Conexiones reusadas por proceso (pool). Si corres Gunicorn con N workers,
# el total de conexiones al MySQL externo puede llegar a N * DB_POOL_SIZE:
# no lo subas mas alla de lo que tu proveedor de MySQL permita en simultaneo.
DB_POOL_SIZE=3

# Correo SMTP para enviar los enlaces de recuperacion.
# Si MAIL_SERVER queda vacio, el correo se imprime en la consola (desarrollo).
# Gmail: activa la verificacion en 2 pasos y crea una "contraseña de aplicacion".
MAIL_SERVER=
# Gmail: MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=UrbanStyle <tucorreo@gmail.com>
