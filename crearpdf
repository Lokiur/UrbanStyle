from fpdf import FPDF

# Crear un nuevo documento PDF
pdf = FPDF()

# Agregar una página
pdf.add_page()

# Establecer fuente y tamaño
pdf.set_font("Arial", size=12)

# Agregar texto
pdf.cell(20, 10, txt="¡Hola, mundo! Esto es un PDF generado con Python.")

# Guardar el PDF
pdf.output("mi_pdf.pdf")